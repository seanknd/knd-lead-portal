# Anthropic — Ivy's brain
ANTHROPIC_API_KEY=sk-ant-...

# JWT signing secret for tokenized portal links (generate with: openssl rand -base64 32)
LINK_SIGNING_SECRET=replace-me-with-a-32-byte-random-string

# Public base URL of the portal (no trailing slash)
PORTAL_BASE_URL=http://localhost:3000

# HubSpot — leave blank in dev; the /api/push-to-hubspot route will run in dry-run mode
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# File storage — leave blank in dev; /api/upload will return mock URLs
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=

# Admin gate (very simple basic-auth password for /admin in dev)
ADMIN_PASSWORD=letmein
